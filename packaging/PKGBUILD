# PKGBUILD for dot-switch-bin
#
# This template is consumed by `.github/workflows/publish.yml` which substitutes
# the version string and SHA-256 sums before pushing to the AUR.
#
# Manual fallback (if you ever need to push by hand):
#   1. Set VERSION, SHA_X86_64, SHA_AARCH64 env vars.
#   2. envsubst < PKGBUILD.tpl > PKGBUILD
#   3. updpkgsums && makepkg --printsrcinfo > .SRCINFO
#   4. git add PKGBUILD .SRCINFO && git commit -m "v$VERSION" && git push
#
# Tokens substituted by CI:
#   %%VERSION%%      — pkgver without the leading 'v' (e.g. "0.1.0")
#   %%SHA_X86_64%%   — sha256sum of the x86_64 musl tarball
#   %%SHA_AARCH64%%  — sha256sum of the aarch64 musl tarball

# Maintainer: Your Name <your@email.dev>
pkgname=dot-switch-bin
pkgver=%%VERSION%%
pkgrel=1
pkgdesc="Swap ~/.config files between named profiles via symlinks. Built for Hyprland/Quickshell, generic for everything."
arch=('x86_64' 'aarch64')
url="https://github.com/lushprey/dot-switch"
license=('MIT')
depends=('gcc-libs' 'zlib')
provides=('dot-switch')
conflicts=('dot-switch' 'dot-switch-git' 'dot-switch-appimage')
options=('!lto' '!strip')  # we ship a stripped musl static binary

_url="https://github.com/lushprey/dot-switch/releases/download/v${pkgver}"

source_x86_64=("${_url}/dot-switch-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('%%SHA_X86_64%%')

source_aarch64=("${_url}/dot-switch-v${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_aarch64=('%%SHA_AARCH64%%')

# noextract=("${source_x86_64[0]##*/}")  # tarballs unpack to a clean dir

package() {
  cd "${srcdir}"

  # tarball structure (from cargo-dist):
  #   dot-switch-v$pkgver-$target-musl/
  #     ├── dot-switch
  #     ├── completions/
  #     │   ├── _dot-switch
  #     │   ├── dot-switch.bash
  #     │   └── dot-switch.fish
  #     └── LICENSE
  local prefix="dot-switch-v${pkgver}"

  # Pick the right extracted dir based on $CARCH
  case "$CARCH" in
    x86_64)   local dir="${prefix}-x86_64-unknown-linux-musl" ;;
    aarch64)  local dir="${prefix}-aarch64-unknown-linux-musl" ;;
    *)        error "unsupported arch: $CARCH"; return 1 ;;
  esac

  install -Dm755 "${dir}/dot-switch" "${pkgdir}/usr/bin/dot-switch"

  # Shell completions — installed to the distro-standard locations.
  install -Dm644 "${dir}/completions/_dot-switch" \
          "${pkgdir}/usr/share/zsh/site-functions/_dot-switch"
  install -Dm644 "${dir}/completions/dot-switch.bash" \
          "${pkgdir}/usr/share/bash-completion/completions/dot-switch"
  install -Dm644 "${dir}/completions/dot-switch.fish" \
          "${pkgdir}/usr/share/fish/vendor_completions.d/dot-switch.fish"

  # LICENSE — always nice to ship.
  install -Dm644 "${dir}/LICENSE" \
          "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
